# Copy to deploy/.env (scripts/init-secrets.sh does this and fills the secrets).
NODE_ENV=production
PORT=3001
PUBLIC_URL=https://vault.example.com
COOKIE_SECURE=true
# client -> your reverse proxy -> clane-vault : one proxy hop
TRUST_PROXY=1
KDF_MIN_MEMORY_KIB=65536
# Postgres password (also used inside DATABASE_URL below; keep them in sync)
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://vault:change-me-postgres@db:5432/vault
# >= 32 chars each; the API refuses to start in production with "change-me" values
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
SERVER_SECRET=change-me-server-secret-at-least-32-chars
# Optional: product name people see in the authenticator app (issuer) and invite emails. Default "Clane Vault".
# The web app's name is set at image build time (build args VITE_PRODUCT_NAME / VITE_PRODUCT_SHORT).
# PRODUCT_NAME=Clane Vault
# Optional: email via Resend, used only when Settings -> Email in the app (Resend or SMTP) isn't set up.
# Leave both commented out (and the app setting empty) and invites show a Copy link instead.
# (docker-compose passes the whole .env to the clane-vault service.)
# RESEND_API_KEY=
# EMAIL_FROM=Clane Vault <vault@yourdomain>
# Organisations (docs/design/2026-10-07-multi-org-design.md).
# Name of the main organisation when it has none yet (default "<PRODUCT_NAME> org").
# DEFAULT_ORG_NAME=
# Whether signed-in users may create organisations (default false). Hosted multi-tenant servers: true.
# ALLOW_ORG_CREATION=false
# Organisations one account may own when creation is allowed (default 5).
# MAX_OWNED_ORGS=5
# Hosted multi-tenant servers: invite links are only ever emailed (never shown to admins; needs RESEND_API_KEY and
# EMAIL_FROM) and sign-up needs a code emailed to the invited address. Default false (self-hosted: copy-link invites).
# HOSTED_MODE=false
# Invites one organisation may send per 24 hours (default 50).
# INVITES_PER_ORG_PER_DAY=50
# Instance admins (Backups) are accounts, not emails: grant with
#   docker compose exec clane-vault node dist/src/scripts/instance-admin.js --email you@company.com --grant
# File attachments (docs/attachments.md): on by default and stored in the database; sizes in MB. With
# ATTACHMENT_STORAGE=s3 set ATTACHMENT_S3_* (a bucket of its own) and back that bucket up yourself.
# ATTACHMENTS_ENABLED=true
# ATTACHMENT_STORAGE=db
# ATTACHMENT_INSTANCE_QUOTA_MB=10240
