# Copy to .env (install.sh / install.ps1 do this and generate the secrets for you).

# Version of the image to run (see update.sh).
CLANE_VAULT_VERSION=1.7.3
# Image repository (public). Override only for a private mirror, e.g. registry.example.com/clane-vault.
CLANE_VAULT_IMAGE=ghcr.io/clane-ai/clane-vault

# Host binding for the web port. Keep 127.0.0.1 and put your own HTTPS reverse proxy in front.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Your own Postgres (14+): postgresql://user:password@host:5432/dbname
# Or the bundled one (profile bundled-db): postgresql://vault:<POSTGRES_PASSWORD>@postgres:5432/vault
DATABASE_URL=postgresql://vault:change-me@postgres:5432/vault
# Bundled Postgres only: password for the "vault" user (must match DATABASE_URL).
POSTGRES_PASSWORD=change-me

# At least 32 characters each. The server refuses to start in production with "change-me" values.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
SERVER_SECRET=change-me-server-secret-at-least-32-chars

# The public https URL users open (used in invite links). No trailing slash.
# To run under a path, include it: PUBLIC_URL=https://northwind.example.com/vault (the app then serves everything,
# API included, under /vault; see README "Running under a path").
PUBLIC_URL=https://vault.example.com
# Optional. The path the app is served under. Leave unset: it is taken from PUBLIC_URL's path. If you set it, it must
# equal PUBLIC_URL's path (e.g. BASE_PATH=/vault with PUBLIC_URL=https://northwind.example.com/vault) or the server won't start.
# BASE_PATH=
# Keep true: cookies are only sent over HTTPS.
COOKIE_SECURE=true
# Number of reverse proxies between the internet and this container (e.g. 1).
TRUST_PROXY=1
# Minimum Argon2 memory (KiB) accepted for account keys.
KDF_MIN_MEMORY_KIB=65536
# Admin recovery after a 2FA reset: hours before the link lets the member set up a new authenticator (docs/recovery.md).
ADMIN_RECOVERY_RESET_DELAY_HOURS=24
# ...and the approving admin must have been an admin at least this many days before the 2FA reset.
ADMIN_RECOVERY_APPROVER_MIN_AGE_DAYS=7
# API requests per minute per client address (sensitive routes have lower limits of their own).
RATE_LIMIT_PER_MINUTE=300

NODE_ENV=production
PORT=3001

# Optional: product name people see in the authenticator app (issuer) and invite emails. Default "Clane Vault".
# The web app's name is set at image build time (build args VITE_PRODUCT_NAME / VITE_PRODUCT_SHORT).
# PRODUCT_NAME=Clane Vault

# Optional: email through Resend. Easier: set email up in the app (Settings -> Email: Resend or SMTP, with a test button);
# these two are only used when the app has no email settings. Leave everything unset to copy invite links manually.
# RESEND_API_KEY=
# EMAIL_FROM=Clane Vault <vault@yourdomain>

# Single sign-on (Settings -> Single sign-on in the app) uses PUBLIC_URL for its redirect URI
# (<PUBLIC_URL>/api/v1/auth/sso/callback). Identity providers must use https.

# Scheduled, encrypted database backups (see README "Backups"). Off by default.
# Make a key pair first: docker compose run --rm --no-deps clane-vault node dist/src/scripts/age-keygen.js > backup-key.txt
# and keep backup-key.txt (the private key) somewhere safe, NOT on this server.
BACKUP_ENABLED=false
# age public key (age1...). Required when enabled: backups are never written unencrypted.
BACKUP_AGE_RECIPIENT=
# 5-field cron, UTC.
BACKUP_SCHEDULE=30 2 * * *
BACKUP_RETENTION_DAYS=14
# S3-compatible storage (AWS S3, Supabase Storage, Cloudflare R2, MinIO...). Setting the bucket enables it.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=clane-vault/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
# And/or a folder inside the container (mount a volume there, see README).
BACKUP_LOCAL_DIR=
# File attachments (see README "Attachments and storage" and docs/attachments.md). Files are encrypted in the browser.
# Default: stored in this database (and included in backups). Sizes in MB.
ATTACHMENTS_ENABLED=true
ATTACHMENT_STORAGE=db
ATTACHMENT_MAX_FILE_MB=100
ATTACHMENT_MAX_PER_RECORD=25
ATTACHMENT_MAX_RECORD_MB=250
ATTACHMENT_ORG_QUOTA_MB=2048
ATTACHMENT_USER_QUOTA_MB=512
# The whole server. On Supabase Free set 200 (or turn attachments off); on Pro with real use, use ATTACHMENT_STORAGE=s3.
ATTACHMENT_INSTANCE_QUOTA_MB=10240
ATTACHMENT_DAILY_UPLOAD_MB=2048
# ATTACHMENT_STORAGE=s3: a bucket of its own (not the backup bucket); back it up yourself (versioning or replication).
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_PREFIX=attachments/
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_FORCE_PATH_STYLE=true
# Organisations: the main organisation's name (default "<PRODUCT_NAME> org") and whether users may create more
# organisations (default false; a single-company install keeps it off).
# DEFAULT_ORG_NAME=
# ALLOW_ORG_CREATION=false
# HOSTED_MODE=false
# hosted: plans and limits for the Clane Vault cloud (docs/plans.md). Self-hosted: leave off.
# BILLING_MODE=off
# Agent access (docs/agents.md): off unless GATEWAY_INTERNAL_URL is set; then the next three are required too.
# The API reaches the gateway's internal port here (the compose internal network; never publish port 3003).
# GATEWAY_INTERNAL_URL=http://gateway:3003
# The public MCP URL, ending in /mcp; the gateway uses this exact value as its PUBLIC_URL (token audience).
# GATEWAY_PUBLIC_URL=https://vault.example.com/mcp
# Shared secret between the API and the gateway, at least 32 characters: openssl rand -hex 32
# GATEWAY_API_TOKEN=
# P-256 PKCS#8 PEM that signs agent access tokens, on one line with \n for newlines (deploy/client/README.md).
# AGENT_TOKEN_PRIVATE_KEY=
# true only to accept a gateway identity that changed (every agent must then be re-enrolled); set back to false after.
# GATEWAY_ACCEPT_NEW_IDENTITY=false
# The gateway's TRUST_PROXY (compose passes it): a number of proxies only, never true/false. Default 1.
# GATEWAY_TRUST_PROXY=1
# Self-hosted only. Never set on a hosted service.
# GATEWAY_ALLOW_PRIVATE_CIDRS=
# Starts the gateway container too: add agents to the list (e.g. COMPOSE_PROFILES=bundled-db,agents).
# COMPOSE_PROFILES=agents
# Public demo server only (docs/demo.md), on its own empty database: throwaway sandboxes for anyone, no authenticator.
# DEMO_MODE=false
# DEMO_TTL_MINUTES=120
# DEMO_SANDBOXES_PER_IP_PER_HOUR=5
