{
  "name": "@clane-vault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bootstrap": "tsx --env-file=.env src/scripts/bootstrap.ts",
    "instance-admin": "tsx --env-file=.env src/scripts/instance-admin.ts",
    "org-owner": "tsx --env-file=.env src/scripts/org-owner.ts",
    "reset-2fa": "tsx --env-file=.env src/scripts/reset-2fa.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@clane-vault/crypto": "^0.1.0",
    "@testcontainers/minio": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.4",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@prisma/client": "^6.19.3",
    "age-encryption": "^0.3.1",
    "argon2": "^0.45.1",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.0",
    "openid-client": "^6.8.8",
    "otplib": "^12.0.1",
    "prisma": "^6.19.3",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  }
}
