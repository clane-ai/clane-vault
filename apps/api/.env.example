DATABASE_URL=postgresql://vault:vault@127.0.0.1:5434/vault
JWT_SECRET=change-me-to-64-random-chars-change-me-to-64-random-chars-xxxxxx
SERVER_SECRET=change-me-to-64-random-chars-change-me-to-64-random-chars-yyyyyy
PUBLIC_URL=http://localhost:5173
# Optional: serve under a path (e.g. /vault). Unset = taken from PUBLIC_URL's path; if set it must equal it.
# BASE_PATH=
COOKIE_SECURE=false
PORT=3001
# Trust X-Forwarded-For: false (default), true, or the number of proxy hops. Behind Nginx Proxy Manager use 1.
TRUST_PROXY=false
# Development only: allow http:// OpenID Connect issuers (a local mock identity provider). Never in production.
# SSO_ALLOW_HTTP_ISSUER=false
# Optional: send email through Resend when the app's Settings -> Email (Resend or SMTP) isn't set up.
# Without either, admins copy the invite link from the People page.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Clane Vault <vault@yourdomain.com>
# File attachments (docs/attachments.md). Defaults: on, stored in this database. Sizes in MB.
# ATTACHMENTS_ENABLED=true
# ATTACHMENT_STORAGE=db
# ATTACHMENT_MAX_FILE_MB=100
# ATTACHMENT_ORG_QUOTA_MB=2048
# ATTACHMENT_USER_QUOTA_MB=512
# ATTACHMENT_INSTANCE_QUOTA_MB=10240
# For ATTACHMENT_STORAGE=s3: ATTACHMENT_S3_ENDPOINT, ATTACHMENT_S3_BUCKET, ATTACHMENT_S3_ACCESS_KEY_ID, ATTACHMENT_S3_SECRET_ACCESS_KEY
# Public demo (docs/demo.md): throwaway sandboxes, deleted after DEMO_TTL_MINUTES. Needs a database without real accounts.
# DEMO_MODE=false
# DEMO_TTL_MINUTES=120
# DEMO_SANDBOXES_PER_IP_PER_HOUR=5
